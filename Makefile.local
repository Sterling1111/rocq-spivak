CAMLPKGS += -package findlib,unix,zarith

# Build the helper from source, including for installed uses of Lib.Psatz.
src/simplex_solver: src/simplex.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -O2 -std=c++17 $$(pkg-config --cflags eigen3) $< -o $@

pre-all:: src/simplex_solver
Lib/Psatz.vo: src/simplex_solver

clean::
	rm -f src/simplex_solver

# Explicit regression targets are also enabled by opam's --with-test option.
.PHONY: check-compat
check-compat: Lib/CoquelicotCompatTests.vo Lib/Tactics.vo
	$(ROCQ) compile $(COQFLAGS) $(COQLIBS) packaging/compat_smoke.v

.PHONY: check-induction
check-induction: Lib/WI_SI_WOTests.vo

.PHONY: check-package
check-package: all
	python3 packaging/check-manifest.py
	$(ROCQ) compile $(COQFLAGS) $(COQLIBS) packaging/full_smoke.v

# Package builds can omit exercise plots and their gnuplot dependency.
BUILD_PLOTS ?= yes
ifeq ($(BUILD_PLOTS),yes)
PLOT_SCRIPTS = \
	Calculus/Chapter11/Problem3/generate_plots.sh \
	Calculus/Chapter13/Problem8/generate_plots.sh \
	Calculus/Chapter18/Problem4/generate_plots.sh \
	Calculus/Chapter18/Problem7/generate_plots.sh \
	Calculus/Chapter18/Problem14/generate_plots.sh \
	Calculus/Chapter18/Problem16/generate_plots.sh \
	Calculus/Chapter18/Problem18/generate_plots.sh

PLOT_DONES = $(PLOT_SCRIPTS:generate_plots.sh=.plots_done)

%/.plots_done: %.vo %/generate_plots.sh
	@echo "Generating plots for $*..."
	@bash $*/generate_plots.sh
	@touch $@

post-all:: $(PLOT_DONES)
endif

# Keep the untrusted candidate generator beside the installed OCaml plugins.
# The generated uninstall target removes the whole calculus findlib package.
install-extra:: src/simplex_solver
	install -m 0644 src/auto_int.py "$(COQPLUGININSTALL)/calculus/auto_int.py"
	install -m 0755 src/simplex_solver "$(COQPLUGININSTALL)/calculus/simplex_solver"
